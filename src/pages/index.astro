---
import Layout from '../layouts/Layout.astro';
import LikesPanel from '../components/LikesPanel.astro';
import { site } from '../data/site';
import { content } from '../data/content';
---
<Layout title="Home">
  <section class="hero container">
    <div class="hero-text">
      <p class="terminal-line">
        <span class="prompt">{content.home.terminalPrompt}</span>
        <a href={`mailto:${site.email}`}>{site.email}</a>
        <span class="sep">&middot;</span>
        <a href={site.github} target="_blank" rel="noopener noreferrer">github</a>
        <span class="sep">&middot;</span>
        <a href={site.linkedin} target="_blank" rel="noopener noreferrer">linkedin</a>
      </p>
      <p class="eyebrow">{site.location}</p>
      <h1>{site.name}</h1>
      <p class="tagline">{site.tagline}</p>
      <div class="hero-actions">
        <a class="btn btn-primary" href="/projects">{content.home.ctaProjects}</a>
        <a class="btn btn-outline" href={site.resumeUrl} target="_blank" rel="noopener noreferrer">{content.home.ctaResume}</a>
      </div>
    </div>
    <div class="hero-avatar">
      <img src={site.headshotUrl} alt={site.name} />
    </div>
  </section>

  <LikesPanel />
</Layout>

<style>
  .hero {
    display: grid;
    grid-template-columns: 1.3fr 1fr;
    align-items: center;
    gap: 3rem;
    padding: 5rem 1.5rem 4rem;
  }
  /* Keep the hero (plus the "Kaz likes to..." heading right after it) filling
     roughly one screen, so the like-panel images require a short scroll to
     reach. 160px is an estimate for the nav bar + heading block height —
     nudge it if the fold lands noticeably off on your screen. */
  @media (min-width: 721px) {
    .hero {
      min-height: calc(100dvh - 160px);
    }
  }
  .terminal-line {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem 0.5rem;
    max-width: 100%;
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, 'Courier New', monospace;
    font-size: 0.9rem;
    color: var(--text-muted);
    background: var(--bg-elevated);
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 0.5rem 0.9rem;
    margin: 0 0 1.25rem;
  }

  .terminal-line .prompt {
    color: var(--accent-soft);
    font-weight: 700;
  }
  .terminal-line a {
    color: var(--text);
    text-decoration: none;
    overflow-wrap: anywhere;
    border-bottom: 1px solid transparent;
    transition: border-color 200ms ease, color 200ms ease;
  }
  .terminal-line a:hover,
  .terminal-line a:focus-visible {
    color: var(--accent-soft);
    border-color: var(--accent-soft);
  }
  .terminal-line .sep {
    color: var(--border);
  }
  .eyebrow {
    color: var(--accent-soft);
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    font-size: 0.85rem;
    margin: 0 0 0.75rem;
  }
  h1 {
    font-size: clamp(2.2rem, 5vw, 3.2rem);
  }
  .tagline {
    color: var(--text-muted);
    font-size: 1.15rem;
    max-width: 40ch;
  }
  .hero-actions {
    display: flex;
    gap: 1rem;
    margin-top: 2rem;
  }
  .hero-avatar {
    aspect-ratio: 1;
    border-radius: 50%;
    overflow: hidden;
    border: 1px solid var(--border);
    background: var(--bg-elevated);
    max-width: 280px;
    margin-left: auto;
  }
  .hero-avatar img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  @media (max-width: 720px) {
    .hero {
      grid-template-columns: 1fr;
      justify-items: center;
    }
    .hero-avatar {
      max-width: 180px;
      width: 180px;
      justify-self: center;
      margin: 0 auto;
    }
  }
</style>
